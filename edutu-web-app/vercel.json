{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://edutu-platform.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://edutu-platform.onrender.com/robots.txt"
    },
    {
      "source": "/opportunity/:id",
      "destination": "https://edutu-platform.onrender.com/og/opportunity/:id"
    },
    {
      "source": "/share/opportunity/:id",
      "destination": "https://edutu-platform.onrender.com/og/share/opportunity/:id"
    },
    {
      "source": "/opportunities",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Slack|Embedly|Pinterest|Flipboard|Tumblr|Mastodon|vkShare|W3C_Validator|SkypeUriPreview|Google-InspectionTool|Applebot|bot|Bot|crawler|Crawler|spider|Spider).*"
        }
      ],
      "destination": "https://edutu-platform.onrender.com/og/opportunities"
    },
    {
      "source": "/((?!assets/|icons/|manifest.webmanifest|registerSW.js|sw.js|workbox-.*\\.js|favicon.ico|apple-touch-icon.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
