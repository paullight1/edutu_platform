{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://edutu-platform.onrender.com/seo/sitemap.xml"
    },
    {
      "source": "/sitemaps/:name.xml",
      "destination": "https://edutu-platform.onrender.com/seo/sitemaps/:name.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://edutu-platform.onrender.com/seo/robots.txt"
    },
    {
      "source": "/blog",
      "destination": "https://edutu-platform.onrender.com/seo/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "https://edutu-platform.onrender.com/seo/blog/:slug"
    },
    {
      "source": "/opportunities",
      "destination": "https://edutu-platform.onrender.com/seo/opportunities"
    },
    {
      "source": "/opportunities/:category",
      "destination": "https://edutu-platform.onrender.com/seo-hydration/opportunities/:category"
    },
    {
      "source": "/opportunity/:id",
      "destination": "https://edutu-platform.onrender.com/seo/opportunity/:id"
    },
    {
      "source": "/share/opportunity/:id",
      "destination": "https://edutu-platform.onrender.com/seo/share/opportunity/:id"
    },
    {
      "source": "/events/:slugOrId",
      "destination": "https://edutu-platform.onrender.com/seo/event/:slugOrId"
    },
    {
      "source": "/community",
      "destination": "/community/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/impact",
      "destination": "/impact/index.html"
    },
    {
      "source": "/edutuforyou",
      "destination": "/edutuforyou/index.html"
    },
    {
      "source": "/whats-new",
      "destination": "/whats-new/index.html"
    },
    {
      "source": "/events",
      "destination": "/events/index.html"
    },
    {
      "source": "/download",
      "destination": "/download/index.html"
    },
    {
      "source": "/what-we-believe",
      "destination": "/what-we-believe/index.html"
    },
    {
      "source": "/upgrade",
      "destination": "/upgrade/index.html"
    },
    {
      "source": "/mentor",
      "destination": "/mentor/index.html"
    },
    {
      "source": "/scholarship-engine",
      "destination": "/scholarship-engine/index.html"
    },
    {
      "source": "/scholarship-api",
      "destination": "/scholarship-api/index.html"
    },
    {
      "source": "/developers",
      "destination": "/developers/index.html"
    },
    {
      "source": "/developers/docs",
      "destination": "/developers/docs/index.html"
    },
    {
      "source": "/help",
      "destination": "/help/index.html"
    },
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/((?!assets/|og/|icons/|manifest.webmanifest|registerSW.js|sw.js|workbox-.*\\.js|favicon.ico|apple-touch-icon.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    }
  ]
}
