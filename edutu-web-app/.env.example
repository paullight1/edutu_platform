# Clerk Authentication (shared with mobile app)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_or_live_xxx

# Absolute login lifetime in hours. After this many hours signed in (regardless
# of activity), the user is signed out and must re-authenticate. Default: 24.
# Keep this aligned with the session token lifetime set in the Clerk Dashboard.
VITE_SESSION_ABSOLUTE_HOURS=24

# Native Google One Tap prompt for unauthenticated visitors. Renders Google's
# own One Tap UI via Clerk. Requires "Google" + One Tap enabled in the Clerk
# Dashboard; set to "false" to hide it. Default: enabled.
VITE_GOOGLE_ONE_TAP=true

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API used by billing, roadmap, AI, admin, and protected app workflows
# (edutu-api.onrender.com is retired and no longer serves traffic)
VITE_API_URL=https://edutu-platform.onrender.com
VITE_BACKEND_URL=https://edutu-platform.onrender.com

# Voice gateway origins are public routing configuration, never credentials.
# Every signalingUrl returned by the join-token endpoint must match one of
# these exact WSS origins. Add all active media nodes, separated by commas.
VITE_VOICE_ALLOWED_WSS_ORIGINS=wss://voice-1.edutu.org
# Optional loopback development fallback only. Production routing always uses
# signalingUrl from POST /communities/calls/:callId/join-token.
VITE_VOICE_WSS_URL=ws://localhost:3100

# Separate admin portal. The user web app redirects /admin/* here instead of bundling admin code.
VITE_ADMIN_URL=https://admin.edutu.org

# Dedicated docs site for Scholarship Engine. Leave VITE_DOCS_URL empty to use
# the in-app docs page at /developers/docs (no external deployment needed).
VITE_DOCS_URL=https://docs.edutu.org
# Public base URL third parties call (shown in code snippets). Defaults to
# VITE_BACKEND_URL + /v1 when empty.
VITE_API_PUBLIC_URL=https://edutu-platform.onrender.com/v1
# OpenAPI document URL. Defaults to VITE_API_PUBLIC_URL + /openapi.json.
VITE_API_OPENAPI_URL=https://edutu-platform.onrender.com/v1/openapi.json

# Next.js marketing site (edutu-web). When set, the public marketing routes
# (/scholarship-api, /scholarship-engine, /developers) redirect here so there
# is one marketing surface. Leave empty until the Next site is deployed.
VITE_MARKETING_URL=

# Public SEO/share canonical URL. Use the exact production domain verified in Google Search Console.
VITE_PUBLIC_SITE_URL=https://www.edutu.org

# Optional Search Console meta verification token. DNS verification is still preferred for production.
VITE_GOOGLE_SITE_VERIFICATION=

# Optional monitoring
VITE_SENTRY_DSN=
VITE_APP_VERSION=

# Optional admin allow-list. Prefer server-side roles/Clerk metadata for production.
VITE_ADMIN_EMAILS=admin@edutu.org

# Optional n8n integration. Do not put private webhook/API secrets in VITE_* values.
VITE_N8N_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Web Push (browser notifications)
# ---------------------------------------------------------------------------
# Until this is set, web push is completely inert: getWebPushState() in
# src/lib/webPush.ts returns "unconfigured" and every opt-in surface renders
# nothing. The backend disables itself the same way without its half of the pair
# (notifications.service.ts logs "Web push disabled: VAPID keys not configured").
#
# 1. Generate ONE keypair — the same pair must be used on both sides:
#
#      npx web-push generate-vapid-keys
#
#    Output looks like:
#      Public Key:  BJ...  (87 chars, base64url)
#      Private Key: k1...  (43 chars, base64url)
#
# 2. PUBLIC key  → this file / the web app's build env (Vercel):
#      VITE_VAPID_PUBLIC_KEY=<public key>
#    It is embedded in the client bundle and is safe to expose.
#
# 3. PRIVATE key → backend env ONLY (Render), never a VITE_* var:
#      VAPID_PUBLIC_KEY=<same public key>
#      VAPID_PRIVATE_KEY=<private key>
#      VAPID_SUBJECT=mailto:support@edutu.org
#    (see backend/services/services/api/.env.example)
#
# Rotating the keypair invalidates every existing browser subscription — users
# must re-subscribe. Rotate only deliberately.
VITE_VAPID_PUBLIC_KEY=
