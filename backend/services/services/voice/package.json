{
  "name": "@edutu/voice-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Ephemeral mediasoup media plane for scheduled Edutu community voice calls",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/real-worker.smoke.test.ts",
    "test:watch": "vitest",
    "test:smoke": "RUN_MEDIASOUP_SMOKE=1 vitest run test/real-worker.smoke.test.ts"
  },
  "dependencies": {
    "jose": "6.1.3",
    "mediasoup": "3.24.1",
    "ws": "8.21.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
