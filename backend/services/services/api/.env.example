NODE_ENV=production
PORT=3000

# Public app origins used by CORS and callback links.
FRONTEND_URL=https://app.edutu.ai
ADMIN_URL=https://admin.edutu.ai
MOBILE_APP_URL=https://app.edutu.ai

# Database / Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth.
# CLERK_SECRET_KEY is the primary token verifier AND enables Clerk API calls
# (user lookups). If it is missing or wrong, EVERY Clerk-authenticated request
# 401s — so keep it set and matching the instance below.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_ISSUER_URL=https://clerk.edutu.org
# Resilience fallback (optional): the guard also verifies tokens directly
# against the instance JWKS when the secret key is unavailable. It needs to
# know the instance — derived automatically from the publishable key above,
# or set CLERK_ISSUER_URL (e.g. https://calm-gecko-44.clerk.accounts.dev)
# explicitly. CLERK_JWT_KEY (the instance PEM public key) enables fully
# networkless SDK verification without the secret key.
# CLERK_ISSUER_URL=
# CLERK_JWT_KEY=

# AI enrichment.
DEEPSEEK_API_KEY=your-deepseek-api-key
AI_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-secret
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Scraper / opportunity processing.
SERPER_API_KEY=
APIFY_WEBHOOK_API_KEY=
SCRAPER_SCHEDULER_ENABLED=true
OPPORTUNITY_VERIFICATION_ENABLED=true
# Internal Edge-to-Render fetch endpoint. Keep disabled until the Edge caller,
# shared secret, and exact source-host allowlist are configured together.
SCRAPE_EGRESS_ENABLED=false
SCRAPE_EGRESS_SHARED_SECRET=
SCRAPE_EGRESS_ALLOWED_HOSTS=
SCRAPE_EGRESS_TIMEOUT_MS=10000
SCRAPE_EGRESS_MAX_RESPONSE_BYTES=1000000
SCRAPE_EGRESS_MAX_REDIRECTS=3
SCRAPE_EGRESS_SIGNATURE_MAX_AGE_SECONDS=300
SCRAPE_EGRESS_MAX_REQUEST_BYTES=4096
SCRAPE_EGRESS_RATE_LIMIT_PER_MINUTE=60
# Optional: post scraper health alerts (failing sources, etc.) to Slack.
SCRAPER_ALERT_SLACK_WEBHOOK_URL=
SCRAPER_ALERT_SLACK_WARNINGS=true

# CV "Import from LinkedIn". The importer tries providers in this order and
# falls back to a best-effort public fetch (LinkedIn usually gates that, so a
# provider key is strongly recommended for real profile data).
# Proxycurl (structured JSON, best): https://nubela.co/proxycurl
PROXYCURL_API_KEY=
# ScrapingBee (renders JS, HTML is then parsed): https://www.scrapingbee.com
SCRAPINGBEE_API_KEY=

# Share-card generation.
# Generated during scraping/backfills and reused by mobile users.
OPPORTUNITY_SHARE_CARD_GENERATION=true
OPPORTUNITY_SHARE_CARD_BUCKET=opportunity-share-cards
OPPORTUNITY_SHARE_CARD_CONCURRENCY=2

# Billing and API-credit checkout.
# Keep checkout disabled until the staging migration, schema audit, provider
# replay tests, and production sign-off in
# docs/operations/edutu-api-launch-checklist.md are complete.
BACHS_CHECKOUT_ENABLED=false
BACHS_ENVIRONMENT=sandbox
BACHS_API_BASE_URL=https://sandbox-api.bachs.io
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_EXPECTED_ORGANIZATION_ID=
# JSON map of the three server-owned API credit catalog keys to Bachs product
# IDs. Do not accept product IDs or prices from clients.
BACHS_PRODUCT_MAPPINGS=
# JSON map containing providerProductId, expectedAmountMinor, currency, and
# environment for api_credits_100, api_credits_250, and api_credits_700.
BACHS_PRODUCT_CATALOG=

# Legacy Paystack compatibility. Leave disabled unless an existing integration
# is explicitly being supported and its raw-body signature path is tested.
LEGACY_PAYSTACK_WEBHOOK_ENABLED=false
PAYSTACK_WEBHOOK_ENABLED=false
PAYSTACK_SECRET_KEY=
BILLING_PUBLIC_URL=https://app.edutu.ai

# API-as-a-service hardening.
# Server-side pepper (>= 16 chars) used to HMAC API keys before hashing.
# In production, generate a strong random value and never commit it.
API_KEY_PEPPER=
# Legacy sha256: entries in EDUTU_API_KEYS are accepted only when this is true
# and API_KEY_PEPPER is set. Keep false in production unless a reviewed,
# time-bounded compatibility exception is approved.
API_KEY_ALLOW_LEGACY_HASHES=false
EDUTU_API_KEYS=

# Public API and documentation URLs used in generated links and OpenAPI docs.
EDUTU_API_PUBLIC_URL=https://api.edutu.org/v1
EDUTU_API_OPENAPI_URL=
EDUTU_DOCS_URL=https://docs.edutu.org
EDUTU_DASHBOARD_URL=https://www.edutu.org/dashboard/developer

# Web Push (browser notifications). Generate with: npx web-push generate-vapid-keys
# Same keypair as the web app's VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@edutu.org

# Two-way calendar sync. All OAuth providers redirect to <API_URL>/calendar/callback.
# Google: OAuth 2.0 Web client (Calendar API enabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Outlook / Microsoft 365: Azure AD app registration (Calendars.ReadWrite + offline_access).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=
# Where to send the user after OAuth (the web app origin).
APP_URL=https://www.edutu.org
# Public base URL of THIS API, used to build the subscribable webcal feed URL.
API_PUBLIC_URL=https://api.edutu.org
# Default iCloud CalDAV base (Apple opt-in two-way); users supply an app-password.
CALDAV_DEFAULT_CALENDAR_URL=https://caldav.icloud.com
# Set to "false" to disable the inbound (provider→Edutu) sync cron.
CALENDAR_SYNC_ENABLED=true

# Redis cache (optional). When set, hot read endpoints (opportunities, roadmaps)
# use a shared Redis cache-aside; otherwise a per-instance in-memory cache is used.
# Install: npm i ioredis  (in backend/services/services/api)
REDIS_URL=

# Scheduled community voice calls. Keep disabled until the media gateway and
# native push credentials are ready. The same >=32-byte HS256 secret is used by
# API and gateway for join (iss=edutu-api, aud=edutu-voice), API-to-gateway
# control (iss=edutu-api, aud=edutu-voice-internal), and gateway-to-API worker
# failure/attendance callbacks (iss=edutu-voice, aud=edutu-api-internal).
# Reverse callbacks use action=media-failed or participant-joined, exact call
# and participant claims, a unique jti, and a short-lived exp. Gateway callback
# timeouts should remain <=5s.
COMMUNITY_CALLS_ENABLED=false
COMMUNITY_CALL_TOKEN_SECRET=
VOICE_GATEWAY_URL=http://voice-gateway.internal:4000
VOICE_GATEWAY_TIMEOUT_MS=5000
COMMUNITY_CALL_JOIN_TOKEN_TTL_SECONDS=60
COMMUNITY_CALL_START_EARLY_MINUTES=5
COMMUNITY_CALL_START_LATE_MINUTES=30
COMMUNITY_CALL_REMINDER_MINUTES=15
COMMUNITY_CALL_RING_SECONDS=45
COMMUNITY_CALL_MAX_DURATION_MINUTES=120
# Required when enabled; choose only after media-host/device load testing.
COMMUNITY_CALL_PARTICIPANT_CAP=
COMMUNITY_CALL_LIFECYCLE_BATCH_SIZE=25
COMMUNITY_CALL_STARTING_TIMEOUT_MINUTES=5

# Native incoming-call push. Missing credentials are safe: the API records the
# adapter as unavailable and uses an Expo fallback when that device has one.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
