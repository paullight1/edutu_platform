NODE_ENV=production
PORT=3000

# Public app origins used by CORS and callback links.
FRONTEND_URL=https://app.edutu.ai
ADMIN_URL=https://admin.edutu.ai
MOBILE_APP_URL=https://app.edutu.ai

# Database / Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth.
# CLERK_SECRET_KEY is the primary token verifier AND enables Clerk API calls
# (user lookups). If it is missing or wrong, EVERY Clerk-authenticated request
# 401s — so keep it set and matching the instance below.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key
# Resilience fallback (optional): the guard also verifies tokens directly
# against the instance JWKS when the secret key is unavailable. It needs to
# know the instance — derived automatically from the publishable key above,
# or set CLERK_ISSUER_URL (e.g. https://calm-gecko-44.clerk.accounts.dev)
# explicitly. CLERK_JWT_KEY (the instance PEM public key) enables fully
# networkless SDK verification without the secret key.
# CLERK_ISSUER_URL=
# CLERK_JWT_KEY=

# AI enrichment.
DEEPSEEK_API_KEY=your-deepseek-api-key
AI_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-secret
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Scraper / opportunity processing.
SERPER_API_KEY=
APIFY_WEBHOOK_API_KEY=
SCRAPER_SCHEDULER_ENABLED=true
OPPORTUNITY_VERIFICATION_ENABLED=true
# Optional: post scraper health alerts (failing sources, etc.) to Slack.
SCRAPER_ALERT_SLACK_WEBHOOK_URL=
SCRAPER_ALERT_SLACK_WARNINGS=true

# CV "Import from LinkedIn". The importer tries providers in this order and
# falls back to a best-effort public fetch (LinkedIn usually gates that, so a
# provider key is strongly recommended for real profile data).
# Proxycurl (structured JSON, best): https://nubela.co/proxycurl
PROXYCURL_API_KEY=
# ScrapingBee (renders JS, HTML is then parsed): https://www.scrapingbee.com
SCRAPINGBEE_API_KEY=

# Share-card generation.
# Generated during scraping/backfills and reused by mobile users.
OPPORTUNITY_SHARE_CARD_GENERATION=true
OPPORTUNITY_SHARE_CARD_BUCKET=opportunity-share-cards
OPPORTUNITY_SHARE_CARD_CONCURRENCY=2

# Optional production integrations.
PAYSTACK_SECRET_KEY=
BILLING_PUBLIC_URL=https://app.edutu.ai
EDUTU_API_KEYS=

# API-as-a-service hardening.
# Server-side pepper (>= 16 chars) used to HMAC API keys before hashing.
# Leave unset for local dev (keys hash with plain SHA-256). In production,
# generate a strong random value and never commit it. Existing keys created
# before setting a pepper keep working until they are rotated.
API_KEY_PEPPER=

# Web Push (browser notifications). Generate with: npx web-push generate-vapid-keys
# Same keypair as the web app's VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@edutu.org

# Two-way calendar sync. All OAuth providers redirect to <API_URL>/calendar/callback.
# Google: OAuth 2.0 Web client (Calendar API enabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Outlook / Microsoft 365: Azure AD app registration (Calendars.ReadWrite + offline_access).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=
# Where to send the user after OAuth (the web app origin).
APP_URL=https://www.edutu.org
# Public base URL of THIS API, used to build the subscribable webcal feed URL.
API_PUBLIC_URL=
# Default iCloud CalDAV base (Apple opt-in two-way); users supply an app-password.
CALDAV_DEFAULT_CALENDAR_URL=https://caldav.icloud.com
# Set to "false" to disable the inbound (provider→Edutu) sync cron.
CALENDAR_SYNC_ENABLED=true

# Redis cache (optional). When set, hot read endpoints (opportunities, roadmaps)
# use a shared Redis cache-aside; otherwise a per-instance in-memory cache is used.
# Install: npm i ioredis  (in backend/services/services/api)
REDIS_URL=
