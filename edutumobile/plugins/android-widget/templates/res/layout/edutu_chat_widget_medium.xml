<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/edutu_cw_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="horizontal" android:padding="14dp" android:background="@drawable/edutu_widget_background">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/edutu_cw_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/edutu_widget_coach_label"
      android:textColor="@color/edutu_widget_accent" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
      android:text="@string/edutu_widget_chat_title" android:textColor="@color/edutu_widget_ink" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/edutu_cw_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
      android:text="@string/edutu_widget_coach_question" android:textColor="@color/edutu_widget_sub" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center"
      android:background="@drawable/edutu_widget_pill" android:text="@string/edutu_widget_ask_action"
      android:textColor="@color/edutu_widget_pill_ink" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <ImageView android:layout_width="104dp" android:layout_height="match_parent" android:layout_marginLeft="8dp"
    android:src="@drawable/edutu_widget_mascot" android:scaleType="fitCenter" android:contentDescription="@null" />
</LinearLayout>
