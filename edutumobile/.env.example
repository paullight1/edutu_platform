EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_live_xxx
EXPO_PUBLIC_SUPABASE_URL=https://sioxocmrjmdevsdlzjns.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_API_URL=https://edutu-platform.onrender.com
EXPO_ROUTER_APP_ROOT=app

# Optional public mobile integrations.
# REQUIRED for in-app Pro purchases. The app sells Pro ONLY through native IAP
# (StoreKit / Play Billing) on device — there is NO external web-checkout
# fallback (Apple 3.1.1 / Google Play Payments). Without these keys (and matching
# RevenueCat products) the paywall CTA is disabled and Pro cannot be bought
# in-app. Supply them to EAS builds (eas.json env / EAS secrets), not just .env.
# For local dev without store setup, a `test_...` Test Store key works for both
# platforms (auto-disabled in release builds — see payments.ts). Production ships
# the real appl_ (iOS) and goog_ (Android) keys from RevenueCat → Apps.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
# DEV-ONLY: set to the Supabase REVENUECAT_WEBHOOK_SECRET to enable the paywall's
# "🔓 Mock Pro" button (grants Pro via the real webhook, no payment). Leave EMPTY
# in any shipped/committed config — it's only for local development.
EXPO_PUBLIC_RC_WEBHOOK_SECRET_DEV=
EXPO_PUBLIC_PROJECT_ID=

# Crash reporting (optional). With this unset, lib/crashReporting is a complete
# no-op — nothing is initialised and nothing is sent. Set it as an EAS env var
# on the `production` environment to receive JS errors, unhandled rejections and
# React render crashes. Reporting is disabled in __DEV__ regardless.
# Native (ObjC/Java) crashes are NOT captured: this repo commits android/ and
# ios/, so EAS skips prebuild and the Sentry config plugin never runs.
EXPO_PUBLIC_SENTRY_DSN=
