{
  "name": "edutu-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "RUBYOPT=-rlogger PATH=\"$HOME/.gem/ruby/2.6.0/bin:$PATH\" expo run:ios --device \"iPhone 17 Pro\"",
    "web": "expo start --web",
    "postinstall": "node scripts/fix-react-native-gradle-settings.js",
    "test": "jest",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "migrate": "supabase db push",
    "deploy:webhook": "supabase functions deploy revenuecat-webhook"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/app",
      "<rootDir>/components",
      "<rootDir>/hooks",
      "<rootDir>/lib",
      "<rootDir>/packages",
      "<rootDir>/widgets",
      "<rootDir>/constants",
      "<rootDir>/types",
      "<rootDir>/data",
      "<rootDir>/__tests__"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts",
      "<rootDir>/test-utils/networkGuard.ts"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "moduleNameMapper": {
      "^expo$": "<rootDir>/test-utils/expoStub.js",
      "^expo/src/winter/.*$": "<rootDir>/empty.js",
      "^@edutu/core/src/(.*)$": "<rootDir>/packages/core/src/$1",
      "^@edutu/core$": "<rootDir>/packages/core/src/index.ts",
      "^@edutu/ux-state/state$": "<rootDir>/../packages/ux-state/src/state/index.ts",
      "^@edutu/ux-state/scenes$": "<rootDir>/../packages/ux-state/src/scenes/index.ts",
      "\\.(wav|mp3|m4a|aac)$": "<rootDir>/empty.js"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/android/",
      "<rootDir>/ios/",
      "<rootDir>/.expo/",
      "<rootDir>/supabase/",
      "<rootDir>/plugins/",
      "<rootDir>/docs/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/.expo/",
      "/supabase/",
      "/plugins/",
      "/docs/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|standard-navigation|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js"
    ]
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.11",
    "@edutu/core": "file:./packages/core",
    "@edutu/ux-state": "file:../packages/ux-state",
    "@expo/ui": "~57.0.26",
    "@expo/vector-icons": "^15.0.2",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react-native": "^1.0.15",
    "@radix-ui/react-slot": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "26.1.0",
    "@react-native-firebase/messaging": "26.1.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.45.1",
    "@types/color": "^4.2.0",
    "@types/react": "^19.2.17",
    "base64-js": "1.5.1",
    "clsx": "^2.1.1",
    "color": "^4.2.3",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.16",
    "expo-background-task": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-calendar": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.24",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.27",
    "i18next": "^26.3.4",
    "lottie-react-native": "^7.3.8",
    "lucide-react-native": "^1.7.0",
    "mediasoup-client": "3.21.0",
    "nativewind": "~4.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.3",
    "react-native-callkeep": "4.3.16",
    "react-native-css-interop": "^0.2.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-purchases": "^10.1.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-voip-push-notification": "3.3.3",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "124.0.8",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "^19.2.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "image-size": "2.0.4"
  },
  "private": true
}
