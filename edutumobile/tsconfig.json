{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@edutu/core": ["./packages/core/src/index.ts"],
      "@edutu/core/hooks/*": ["./packages/core/src/hooks/*.ts"],
      "@edutu/core/types/*": ["./packages/core/src/types/*.ts"],
      "@edutu/core/services/*": ["./packages/core/src/services/*.ts"],
      "@edutu/core/src/*": ["./packages/core/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    // Tests are typechecked by Jest's own transform, not by `tsc --noEmit`, and
    // the repo carries no @types/jest — so app typechecking skips them. The
    // glob covers colocated suites (components/state/__tests__, lib/__tests__)
    // as well as the root directory; the bare "__tests__" entry this replaces
    // matched only the root one.
    "**/__tests__"
  ]
}
