        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/edutu_widget_sub"
        android:textSize="10sp" />
    </LinearLayout>
    <TextView
      android:id="@+id/edutu_tw_r4_deadline"
      android:layout_width="wrap_content"
