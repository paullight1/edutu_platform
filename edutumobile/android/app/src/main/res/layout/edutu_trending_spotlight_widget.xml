<?xml version="1.0" encoding="utf-8"?>
<!--
  Trending Spotlight — a 2x2 poster that auto-rotates through the hottest
  opportunities on-device. The ViewFlipper fades between four full-bleed image
  posters every few seconds (no app wake-up needed); the provider fills each
  poster's background photo, category, title and deadline.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/edutu_ts_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/edutu_widget_background">

  <ViewFlipper
    android:id="@+id/edutu_ts_flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autoStart="true"
    android:flipInterval="5000"
    android:inAnimation="@android:anim/fade_in"
    android:outAnimation="@android:anim/fade_out">

    <!-- Poster 1 -->
    <FrameLayout
      android:id="@+id/edutu_ts_p1"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/edutu_widget_bg">
      <ImageView
        android:id="@+id/edutu_ts_p1_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />
      <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/edutu_widget_scrim" />
      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:src="@drawable/edutu_widget_logo"
        android:contentDescription="@null" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView
          android:id="@+id/edutu_ts_p1_category"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/edutu_widget_poster_chip"
          android:paddingLeft="9dp"
          android:paddingRight="9dp"
          android:paddingTop="2dp"
          android:paddingBottom="2dp"
          android:maxLines="1"
          android:ellipsize="end"
          android:textColor="#FFFFFF"
          android:textSize="10sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_ts_p1_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:ellipsize="end"
          android:maxLines="2"
          android:textColor="#FFFFFF"
          android:textSize="16sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_ts_p1_deadline"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:maxLines="1"
          android:ellipsize="end"
          android:textColor="#E6FFFFFF"
          android:textSize="11sp"
          android:textStyle="bold" />
      </LinearLayout>
    </FrameLayout>

    <!-- Poster 2 -->
    <FrameLayout
      android:id="@+id/edutu_ts_p2"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/edutu_widget_bg">
      <ImageView
        android:id="@+id/edutu_ts_p2_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />
      <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/edutu_widget_scrim" />
      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:src="@drawable/edutu_widget_logo"
        android:contentDescription="@null" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView
          android:id="@+id/edutu_ts_p2_category"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/edutu_widget_poster_chip"
          android:paddingLeft="9dp"
          android:paddingRight="9dp"
          android:paddingTop="2dp"
          android:paddingBottom="2dp"
          android:maxLines="1"
          android:ellipsize="end"
          android:textColor="#FFFFFF"
          android:textSize="10sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_ts_p2_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:ellipsize="end"
          android:maxLines="2"
          android:textColor="#FFFFFF"
          android:textSize="16sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_ts_p2_deadline"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:maxLines="1"
          android:ellipsize="end"
          android:textColor="#E6FFFFFF"
          android:textSize="11sp"
          android:textStyle="bold" />
      </LinearLayout>
    </FrameLayout>

    <!-- Poster 3 -->
    <FrameLayout
      android:id="@+id/edutu_ts_p3"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/edutu_widget_bg">
      <ImageView
        android:id="@+id/edutu_ts_p3_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />
      <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/edutu_widget_scrim" />
      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:src="@drawable/edutu_widget_logo"
        android:contentDescription="@null" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView
          android:id="@+id/edutu_ts_p3_category"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/edutu_widget_poster_chip"
          android:paddingLeft="9dp"
          android:paddingRight="9dp"
          android:paddingTop="2dp"
          android:paddingBottom="2dp"
          android:maxLines="1"
          android:ellipsize="end"
          android:textColor="#FFFFFF"
          android:textSize="10sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_ts_p3_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:ellipsize="end"
          android:maxLines="2"
          android:textColor="#FFFFFF"
          android:textSize="16sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_ts_p3_deadline"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:maxLines="1"
          android:ellipsize="end"
          android:textColor="#E6FFFFFF"
          android:textSize="11sp"
          android:textStyle="bold" />
      </LinearLayout>
    </FrameLayout>

    <!-- Poster 4 -->
    <FrameLayout
      android:id="@+id/edutu_ts_p4"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/edutu_widget_bg">
      <ImageView
        android:id="@+id/edutu_ts_p4_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />
      <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/edutu_widget_scrim" />
      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:src="@drawable/edutu_widget_logo"
        android:contentDescription="@null" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView
          android:id="@+id/edutu_ts_p4_category"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/edutu_widget_poster_chip"
          android:paddingLeft="9dp"
          android:paddingRight="9dp"
          android:paddingTop="2dp"
          android:paddingBottom="2dp"
          android:maxLines="1"
          android:ellipsize="end"
          android:textColor="#FFFFFF"
          android:textSize="10sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_ts_p4_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:ellipsize="end"
          android:maxLines="2"
          android:textColor="#FFFFFF"
          android:textSize="16sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_ts_p4_deadline"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:maxLines="1"
          android:ellipsize="end"
          android:textColor="#E6FFFFFF"
          android:textSize="11sp"
          android:textStyle="bold" />
      </LinearLayout>
    </FrameLayout>
  </ViewFlipper>

  <!-- Empty state -->
  <LinearLayout
    android:id="@+id/edutu_ts_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:visibility="gone">
    <ImageView
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:src="@drawable/edutu_widget_logo"
      android:contentDescription="@null" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:gravity="center"
      android:maxLines="2"
      android:text="@string/edutu_widget_trending_empty"
      android:textColor="@color/edutu_widget_ink"
      android:textSize="13sp"
      android:textStyle="bold" />
  </LinearLayout>
</FrameLayout>
