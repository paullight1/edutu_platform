<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/edutu_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="16dp"
  android:background="@drawable/edutu_widget_background">

  <TextView
    android:id="@+id/edutu_widget_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/edutu_widget_radar"
    android:textColor="#DCE7FF"
    android:textSize="13sp"
    android:textStyle="bold" />

  <!-- Row 1 -->
  <LinearLayout
    android:id="@+id/edutu_widget_r1"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="10dp"
    android:orientation="vertical"
    android:gravity="center_vertical">
    <TextView
      android:id="@+id/edutu_widget_r1_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@android:color/white"
      android:textSize="14sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/edutu_widget_r1_deadline"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#10B981"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <!-- Row 2 -->
  <LinearLayout
    android:id="@+id/edutu_widget_r2"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center_vertical">
    <TextView
      android:id="@+id/edutu_widget_r2_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@android:color/white"
      android:textSize="14sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/edutu_widget_r2_deadline"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#10B981"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <!-- Row 3 -->
  <LinearLayout
    android:id="@+id/edutu_widget_r3"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center_vertical">
    <TextView
      android:id="@+id/edutu_widget_r3_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@android:color/white"
      android:textSize="14sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/edutu_widget_r3_deadline"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#10B981"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
