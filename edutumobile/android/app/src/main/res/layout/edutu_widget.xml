<?xml version="1.0" encoding="utf-8"?>
<!-- Top Matches — expanded (default) size. Adaptive navy; logo-only branding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/edutu_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="16dp"
  android:background="@drawable/edutu_widget_background">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/edutu_widget_logo"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:src="@drawable/edutu_widget_logo"
      android:contentDescription="@null" />

    <View
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />

    <TextView
      android:id="@+id/edutu_widget_match"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:paddingLeft="9dp"
      android:paddingRight="9dp"
      android:paddingTop="3dp"
      android:paddingBottom="3dp"
      android:background="@drawable/edutu_widget_pill"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/edutu_widget_pick"
      android:textColor="@color/edutu_widget_pill_ink"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/edutu_widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:ellipsize="end"
    android:maxLines="2"
    android:text="@string/edutu_widget_title"
    android:textColor="@color/edutu_widget_ink"
    android:textSize="16sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/edutu_widget_subtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/edutu_widget_subtitle"
    android:textColor="@color/edutu_widget_sub"
    android:textSize="12sp" />

  <View
    android:layout_width="1dp"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <TextView
    android:id="@+id/edutu_widget_deadline"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/edutu_widget_chip_slate"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/edutu_widget_open_now"
    android:textColor="#FFFFFF"
    android:textSize="12sp"
    android:textStyle="bold" />
</LinearLayout>
