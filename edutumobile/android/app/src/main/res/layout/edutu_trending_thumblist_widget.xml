<?xml version="1.0" encoding="utf-8"?>
<!--
  Trending Thumbnail List — a ranked list of trending opportunities, each row a
  photo thumbnail + title/organization + urgency-coloured deadline. The provider
  hides rows that have no item and loads thumbnails off the main thread.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/edutu_thl_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/edutu_widget_background">

  <LinearLayout
    android:id="@+id/edutu_thl_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">
      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/edutu_widget_logo"
        android:contentDescription="@null" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:text="@string/edutu_widget_trending"
        android:textColor="@color/edutu_widget_ink"
        android:textSize="13sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/edutu_thl_r1"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:layout_marginTop="8dp"
      android:orientation="horizontal"
      android:gravity="center_vertical">
      <ImageView
        android:id="@+id/edutu_thl_r1_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:background="@drawable/edutu_widget_inset"
        android:contentDescription="@null" />
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">
        <TextView
          android:id="@+id/edutu_thl_r1_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/edutu_widget_ink"
          android:textSize="13sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_thl_r1_meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/edutu_widget_sub"
          android:textSize="10sp" />
      </LinearLayout>
      <TextView
        android:id="@+id/edutu_thl_r1_deadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:textColor="@color/edutu_urgency_green"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/edutu_thl_r2"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal"
      android:gravity="center_vertical">
      <ImageView
        android:id="@+id/edutu_thl_r2_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:background="@drawable/edutu_widget_inset"
        android:contentDescription="@null" />
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">
        <TextView
          android:id="@+id/edutu_thl_r2_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/edutu_widget_ink"
          android:textSize="13sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_thl_r2_meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/edutu_widget_sub"
          android:textSize="10sp" />
      </LinearLayout>
      <TextView
        android:id="@+id/edutu_thl_r2_deadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:textColor="@color/edutu_urgency_green"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/edutu_thl_r3"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal"
      android:gravity="center_vertical">
      <ImageView
        android:id="@+id/edutu_thl_r3_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:background="@drawable/edutu_widget_inset"
        android:contentDescription="@null" />
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">
        <TextView
          android:id="@+id/edutu_thl_r3_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/edutu_widget_ink"
          android:textSize="13sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_thl_r3_meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/edutu_widget_sub"
          android:textSize="10sp" />
      </LinearLayout>
      <TextView
        android:id="@+id/edutu_thl_r3_deadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:textColor="@color/edutu_urgency_green"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/edutu_thl_r4"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal"
      android:gravity="center_vertical">
      <ImageView
        android:id="@+id/edutu_thl_r4_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:background="@drawable/edutu_widget_inset"
        android:contentDescription="@null" />
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">
        <TextView
          android:id="@+id/edutu_thl_r4_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/edutu_widget_ink"
          android:textSize="13sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/edutu_thl_r4_meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/edutu_widget_sub"
          android:textSize="10sp" />
      </LinearLayout>
      <TextView
        android:id="@+id/edutu_thl_r4_deadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:textColor="@color/edutu_urgency_green"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/edutu_thl_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:visibility="gone">
    <ImageView
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:src="@drawable/edutu_widget_logo"
      android:contentDescription="@null" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:gravity="center"
      android:maxLines="2"
      android:text="@string/edutu_widget_trending_empty"
      android:textColor="@color/edutu_widget_ink"
      android:textSize="13sp"
      android:textStyle="bold" />
  </LinearLayout>
</FrameLayout>
