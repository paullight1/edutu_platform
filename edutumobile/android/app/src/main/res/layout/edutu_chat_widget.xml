<?xml version="1.0" encoding="utf-8"?>
<!-- Ask Edutu — one-tap launcher into AI chat. Logo front and center. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/edutu_cw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center_horizontal"
  android:padding="14dp"
  android:background="@drawable/edutu_widget_background">

  <View
    android:layout_width="1dp"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <ImageView
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:src="@drawable/edutu_widget_logo"
    android:contentDescription="@null" />

  <View
    android:layout_width="1dp"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <TextView
    android:id="@+id/edutu_cw_prompt"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/edutu_widget_input"
    android:ellipsize="end"
    android:gravity="center"
    android:maxLines="1"
    android:text="@string/edutu_widget_chat_prompt"
    android:textColor="@color/edutu_widget_sub"
    android:textSize="11sp"
    android:textStyle="bold" />
</LinearLayout>
