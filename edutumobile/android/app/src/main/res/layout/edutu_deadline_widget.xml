  </LinearLayout>

  <LinearLayout
    android:id="@+id/edutu_dw_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:visibility="gone">
    <ImageView
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:src="@drawable/edutu_widget_logo"
      android:contentDescription="@null" />
    <View
      android:layout_width="1dp"
      android:layout_height="0dp"
      android:layout_weight="1" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="2"
      android:text="@string/edutu_widget_no_deadlines"
      android:textColor="@color/edutu_widget_ink"
      android:textSize="14sp"
      android:textStyle="bold" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:maxLines="2"
      android:text="@string/edutu_widget_no_deadlines_hint"
      android:textColor="@color/edutu_widget_sub"
      android:textSize="11sp" />
  </LinearLayout>
</FrameLayout>
