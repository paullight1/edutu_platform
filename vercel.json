{
  "services": {
    "frontend": {
      "root": "edutu-web-app",
      "framework": "vite"
    },
    "admin": {
      "root": "admin",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://backend.edutu.org/seo/sitemap.xml"
    },
    {
      "source": "/sitemaps/:name.xml",
      "destination": "https://backend.edutu.org/seo/sitemaps/:name.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://backend.edutu.org/seo/robots.txt"
    },
    {
      "source": "/blog",
      "destination": "https://backend.edutu.org/seo/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "https://backend.edutu.org/seo/blog/:slug"
    },
    {
      "source": "/opportunities",
      "destination": "https://backend.edutu.org/seo/opportunities"
    },
    {
      "source": "/opportunities/:category",
      "destination": "https://backend.edutu.org/seo-hydration/opportunities/:category"
    },
    {
      "source": "/opportunity/:id",
      "destination": "https://backend.edutu.org/seo/opportunity/:id"
    },
    {
      "source": "/share/opportunity/:id",
      "destination": "https://backend.edutu.org/seo/share/opportunity/:id"
    },
    {
      "source": "/events/:slugOrId",
      "destination": "https://backend.edutu.org/seo/event/:slugOrId"
    },
    {
      "source": "/community",
      "destination": "/community/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/impact",
      "destination": "/impact/index.html"
    },
    {
      "source": "/edutuforyou",
      "destination": "/edutuforyou/index.html"
    },
    {
      "source": "/whats-new",
      "destination": "/whats-new/index.html"
    },
    {
      "source": "/events",
      "destination": "/events/index.html"
    },
    {
      "source": "/download",
      "destination": "/download/index.html"
    },
    {
      "source": "/what-we-believe",
      "destination": "/what-we-believe/index.html"
    },
    {
      "source": "/upgrade",
      "destination": "/upgrade/index.html"
    },
    {
      "source": "/mentor",
      "destination": "/mentor/index.html"
    },
    {
      "source": "/scholarship-engine",
      "destination": "/scholarship-engine/index.html"
    },
    {
      "source": "/scholarship-api",
      "destination": "/scholarship-api/index.html"
    },
    {
      "source": "/developers",
      "destination": "/developers/index.html"
    },
    {
      "source": "/developers/docs",
      "destination": "/developers/docs/index.html"
    },
    {
      "source": "/help",
      "destination": "/help/index.html"
    },
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": {
        "service": "admin",
        "path": "/:path*"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend",
        "path": "/:path*"
      }
    }
  ]
}
