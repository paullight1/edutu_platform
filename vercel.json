{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "edutu-web-app",
      "framework": "vite"
    },
    "admin": {
      "root": "admin",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/opportunity/:id",
      "destination": "https://edutu-platform.onrender.com/og/opportunity/:id"
    },
    {
      "source": "/share/opportunity/:id",
      "destination": "https://edutu-platform.onrender.com/og/share/opportunity/:id"
    },
    {
      "source": "/admin/:path*",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
