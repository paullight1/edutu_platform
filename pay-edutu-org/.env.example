# ─── pay.edutu.org environment ───────────────────────────────────────────────
# Copy to .env.local for local dev; set the same vars in Vercel/host for prod.

# Public origin of THIS app (used to build Paystack callback URLs). No trailing slash.
BASE_URL=https://pay.edutu.org

# ─── Paystack ─────────────────────────────────────────────────────────────────
# From dashboard → Settings → API Keys & Webhooks. Use test keys locally.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Optional: if you create recurring Plans in Paystack, put their plan codes here
# to turn checkouts into auto-renewing subscriptions. Leave blank for one-time
# charges that grant a fixed period (monthly = 31d, yearly = 366d).
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_YEARLY=

# ─── Supabase (Edutu database) ────────────────────────────────────────────────
# SERVICE ROLE key — this app writes entitlements server-side only. Never expose.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_xxx

# ─── Edutu backend (source of admin-set prices) ───────────────────────────────
# The paywall + this checkout read prices from the same admin config so the
# amount charged always matches what the user saw. No trailing slash.
EDUTU_API_URL=https://edutu-platform.onrender.com

# Fallback prices used only if EDUTU_API_URL is unreachable (major units).
FALLBACK_CURRENCY=USD
FALLBACK_PRICE_MONTHLY=9.99
FALLBACK_PRICE_YEARLY=71.88

# ─── Mobile app deep link (return after payment) ──────────────────────────────
APP_DEEP_LINK_SCHEME=edutu

# ─── Admin dashboard ──────────────────────────────────────────────────────────
# Bearer token that guards /admin (see users, award free Pro / bonanzas).
ADMIN_DASHBOARD_TOKEN=change-me-to-a-long-random-string
