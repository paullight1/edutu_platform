# pay.edutu.org server-only configuration. Set these in Vercel; do not expose
# them through NEXT_PUBLIC variables and never add values to this file.

# Canonical authenticated Nest billing API origin. It is the only payment
# authority and must serve the documented /billing pay-shell endpoints.
EDUTU_BILLING_API_URL=https://api.edutu.org

# Public origin of this deployment. POST routes require this exact Origin to
# protect the opaque billing-session cookie from cross-site requests.
PAY_SHELL_ORIGIN=https://pay.edutu.org

# New Bachs collection remains off unless explicitly enabled in the canonical
# API rollout. This shell does not create checkout sessions regardless.
BACHS_CHECKOUT_ENABLED=false
